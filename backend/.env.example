SUPABASE_DB_URL=jdbc:postgresql://<host>.pooler.supabase.com:5432/postgres?user=postgres.<ref>&password=<password>&sslmode=require
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<key service_role>

